@@ -13,6 +13,216 @@
 
 #include "rstl/math.hpp"
 
+#ifdef __vita__
+// The Vita build shows an original handheld in place of the GameCube model: a
+// dark slab with rounded corners, a glowing screen, a stick and a D-pad on the
+// left, a stick and four round buttons on the right, and a blue light strip
+// around its edge. Built here and shaded on the CPU (one fixed light), drawn
+// with the engine's colour stream.
+#include <cmath>
+#include <vector>
+
+namespace {
+struct HVert {
+  float p[3];
+  float n[3];
+  float c[3];
+  bool emissive;
+};
+std::vector< HVert > sHandheld;
+
+void AddTri(const float* a, const float* b, const float* c, const float* n, const float* col, bool emissive) {
+  const float* pts[3] = {a, b, c};
+  for (int i = 0; i < 3; ++i) {
+    HVert v;
+    for (int k = 0; k < 3; ++k) {
+      v.p[k] = pts[i][k];
+      v.n[k] = n[k];
+      v.c[k] = col[k];
+    }
+    v.emissive = emissive;
+    sHandheld.push_back(v);
+  }
+}
+
+// A rounded rectangle in the XZ plane (x half-width hw, z half-height hh, corner
+// radius r), counter-clockwise seen from -Y.
+std::vector< float > RoundRect(float hw, float hh, float r, int segs) {
+  std::vector< float > out;
+  const float cx[4] = {hw - r, -(hw - r), -(hw - r), hw - r};
+  const float cz[4] = {hh - r, hh - r, -(hh - r), -(hh - r)};
+  for (int q = 0; q < 4; ++q) {
+    for (int i = 0; i <= segs; ++i) {
+      const float a = (q * 90.f + 90.f * i / segs) * 3.14159265f / 180.f;
+      out.push_back(cx[q] + r * std::cos(a));
+      out.push_back(cz[q] + r * std::sin(a));
+    }
+  }
+  return out;
+}
+
+// A flat face (fan from its centre) at depth y facing -Y (front) or +Y (back);
+// colour from the centre to the rim when they differ.
+void Face(const std::vector< float >& o, float ox, float oz, float y, bool front, const float* cIn, const float* cOut,
+          bool emissive) {
+  const int n = static_cast< int >(o.size() / 2);
+  const float nrm[3] = {0.f, front ? -1.f : 1.f, 0.f};
+  for (int i = 0; i < n; ++i) {
+    const int j = (i + 1) % n;
+    const float c[3] = {ox, y, oz};
+    const float a[3] = {ox + o[i * 2], y, oz + o[i * 2 + 1]};
+    const float b[3] = {ox + o[j * 2], y, oz + o[j * 2 + 1]};
+    // Centre and rim colours: split each fan triangle's colour by vertex.
+    HVert vc, va, vb;
+    const float* pts[3] = {c, a, b};
+    HVert* vs[3] = {&vc, &va, &vb};
+    for (int k = 0; k < 3; ++k) {
+      for (int m = 0; m < 3; ++m) {
+        vs[k]->p[m] = pts[k][m];
+        vs[k]->n[m] = nrm[m];
+        vs[k]->c[m] = k == 0 ? cIn[m] : cOut[m];
+      }
+      vs[k]->emissive = emissive;
+    }
+    sHandheld.push_back(vc);
+    sHandheld.push_back(front ? va : vb);
+    sHandheld.push_back(front ? vb : va);
+  }
+}
+
+// The side wall of an outline between depths y0 and y1.
+void Wall(const std::vector< float >& o, float ox, float oz, float y0, float y1, const float* col, bool emissive) {
+  const int n = static_cast< int >(o.size() / 2);
+  for (int i = 0; i < n; ++i) {
+    const int j = (i + 1) % n;
+    const float ax = ox + o[i * 2], az = oz + o[i * 2 + 1];
+    const float bx = ox + o[j * 2], bz = oz + o[j * 2 + 1];
+    float nx = bz - az, nz = -(bx - ax);
+    const float l = std::sqrt(nx * nx + nz * nz);
+    if (l < 1e-6f) continue;
+    const float nrm[3] = {nx / l, 0.f, nz / l};
+    const float p0[3] = {ax, y0, az}, p1[3] = {bx, y0, bz}, p2[3] = {bx, y1, bz}, p3[3] = {ax, y1, az};
+    AddTri(p0, p1, p2, nrm, col, emissive);
+    AddTri(p0, p2, p3, nrm, col, emissive);
+  }
+}
+
+// A raised part: its top face at y0 - h and its wall down to y0.
+void Raised(const std::vector< float >& o, float ox, float oz, float y0, float h, const float* top, const float* rim,
+            const float* side) {
+  Face(o, ox, oz, y0 - h, true, top, rim, false);
+  Wall(o, ox, oz, y0 - h, y0, side, false);
+}
+
+void BuildHandheld() {
+  if (!sHandheld.empty()) return;
+  const float shell[3] = {0.16f, 0.17f, 0.20f};
+  const float shellBack[3] = {0.12f, 0.13f, 0.15f};
+  const float glow[3] = {0.25f, 0.65f, 1.00f};
+  const float scrIn[3] = {0.16f, 0.36f, 0.62f};
+  const float scrOut[3] = {0.03f, 0.07f, 0.16f};
+  const float bezel[3] = {0.05f, 0.05f, 0.06f};
+  const float stickTop[3] = {0.30f, 0.31f, 0.34f};
+  const float stickRim[3] = {0.18f, 0.19f, 0.21f};
+  const float dark[3] = {0.09f, 0.09f, 0.10f};
+  const float pad[3] = {0.26f, 0.27f, 0.30f};
+  const float btnTop[3] = {0.78f, 0.80f, 0.84f};
+  const float btnRim[3] = {0.55f, 0.58f, 0.64f};
+
+  const float hw = 0.56f, hh = 0.25f, half = 0.05f;
+  const std::vector< float > body = RoundRect(hw, hh, 0.11f, 6);
+  Face(body, 0.f, 0.f, -half, true, shell, shell, false);
+  Face(body, 0.f, 0.f, half, false, shellBack, shellBack, false);
+  Wall(body, 0.f, 0.f, -half, -0.012f, shell, false);
+  Wall(body, 0.f, 0.f, -0.012f, 0.012f, glow, true); // the light strip
+  Wall(body, 0.f, 0.f, 0.012f, half, shellBack, false);
+
+  // Screen: a dark bezel and the glowing panel.
+  Face(RoundRect(0.315f, 0.195f, 0.035f, 4), 0.f, 0.015f, -half - 0.004f, true, bezel, bezel, false);
+  Face(RoundRect(0.29f, 0.17f, 0.02f, 4), 0.f, 0.015f, -half - 0.008f, true, scrIn, scrOut, true);
+
+  // Sticks (lower left and lower right): a low cylinder with a dished cap.
+  const std::vector< float > stick = RoundRect(0.055f, 0.055f, 0.0549f, 6);
+  const std::vector< float > cap = RoundRect(0.035f, 0.035f, 0.0349f, 6);
+  for (int side = -1; side <= 1; side += 2) {
+    const float x = side * 0.435f, z = -0.105f;
+    Face(RoundRect(0.068f, 0.068f, 0.0679f, 6), x, z, -half - 0.004f, true, dark, dark, false);
+    Raised(stick, x, z, -half, 0.03f, stickRim, stickRim, dark);
+    Face(cap, x, z, -half - 0.034f, true, stickTop, stickRim, false);
+  }
+
+  // D-pad (upper left): two crossed bars.
+  {
+    const float x = -0.435f, z = 0.085f;
+    Raised(RoundRect(0.06f, 0.019f, 0.006f, 2), x, z, -half, 0.012f, pad, pad, dark);
+    Raised(RoundRect(0.019f, 0.06f, 0.006f, 2), x, z, -half, 0.0121f, pad, pad, dark);
+  }
+
+  // Four round buttons (upper right) in a diamond.
+  {
+    const float x = 0.435f, z = 0.085f, d = 0.046f;
+    const float ox[4] = {0.f, d, 0.f, -d}, oz[4] = {d, 0.f, -d, 0.f};
+    const std::vector< float > btn = RoundRect(0.021f, 0.021f, 0.0209f, 5);
+    for (int i = 0; i < 4; ++i) Raised(btn, x + ox[i], z + oz[i], -half, 0.012f, btnTop, btnRim, btnRim);
+  }
+
+  // Shoulder buttons on the top edge, left and right: a rounded block standing
+  // out of the edge.
+  for (int side = -1; side <= 1; side += 2) {
+    const std::vector< float > sh = RoundRect(0.11f, 0.03f, 0.012f, 3);
+    const float x = side * 0.39f, z = hh - 0.005f;
+    // Built as a slab in the XZ plane, then its faces moved to sit along the edge.
+    Face(sh, x, z, -0.032f, true, pad, pad, false);
+    Face(sh, x, z, 0.032f, false, dark, dark, false);
+    Wall(sh, x, z, -0.032f, 0.032f, dark, false);
+  }
+
+  // Two small pill buttons under the screen.
+  for (int side = -1; side <= 1; side += 2)
+    Raised(RoundRect(0.03f, 0.009f, 0.0089f, 3), side * 0.06f, -0.215f, -half, 0.006f, pad, pad, dark);
+}
+
+void DrawHandheld(float alpha) {
+  BuildHandheld();
+  const float f = (CGraphics::GetSecondsMod900() * 360.f) * 0.25f;
+  const CTransform4f rot =
+      CTransform4f::RotateZ(CRelAngle::FromDegrees(-f)) * CTransform4f::RotateX(CRelAngle::FromDegrees(-12.f));
+  CGraphics::SetModelMatrix(rot * CTransform4f::Scale(0.75f));
+  CGraphics::DisableAllLights();
+  CGraphics::SetTevOp(kTS_Stage0, CGraphics::kEnvPassthru);
+  CGraphics::SetTevOp(kTS_Stage1, CGraphics::kEnvPassthru);
+  CGraphics::SetBlendMode(kBM_Blend, kBF_SrcAlpha, kBF_InvSrcAlpha, kLO_Clear);
+  CGraphics::SetDepthWriteMode(true, kE_LEqual, true);
+  CGraphics::SetCullMode(kCM_None);
+
+  // Light from the upper left, on the viewer's side (the camera looks along +Y).
+  float lx = -0.45f, ly = -1.f, lz = 0.6f;
+  const float ll = std::sqrt(lx * lx + ly * ly + lz * lz);
+  lx /= ll, ly /= ll, lz /= ll;
+  const uchar a = static_cast< uchar >(rstl::max_val(0.f, rstl::min_val(1.f, alpha)) * 255.f);
+
+  CGraphics::StreamBegin(kP_Triangles);
+  for (const HVert& v : sHandheld) {
+    float r = v.c[0], g = v.c[1], b = v.c[2];
+    if (!v.emissive) {
+      const CVector3f n = rot * CVector3f(v.n[0], v.n[1], v.n[2]);
+      const float d = rstl::max_val(0.f, n.GetX() * lx + n.GetY() * ly + n.GetZ() * lz);
+      // Ambient, diffuse, and a soft sheen where the surface faces the light.
+      const float k = 0.38f + 0.75f * d;
+      const float sheen = d > 0.9f ? (d - 0.9f) * 2.5f : 0.f;
+      r = r * k + sheen, g = g * k + sheen, b = b * k + sheen;
+    }
+    const uint col = (static_cast< uint >(rstl::min_val(1.f, r) * 255.f) << 24) |
+                     (static_cast< uint >(rstl::min_val(1.f, g) * 255.f) << 16) |
+                     (static_cast< uint >(rstl::min_val(1.f, b) * 255.f) << 8) | a;
+    CGraphics::StreamColor(col);
+    CGraphics::StreamVertex(v.p[0], v.p[1], v.p[2]);
+  }
+  CGraphics::StreamEnd();
+}
